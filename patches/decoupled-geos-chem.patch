 !
@@ -88,9 +97,14 @@ MODULE FullChem_Mod
   REAL(f4), ALLOCATABLE :: JvSumDay  (:,:,:,:)
   REAL(f4), ALLOCATABLE :: JvSumMon  (:,:,:,:)
 
-#if defined(MPI_LOAD_BALANCE)
-  ! For load balancing implementation
+#if defined(MPI_LOAD_BALANCE) || defined(DECOUPLED_CHEM)
+  ! Flat per-rank buffers for the gather->solve->scatter chemistry seam.
+  ! Shared by the MPI load-balance backend and the DECOUPLED_CHEM in-process
+  ! backend (Phase 0 of decoupled chemistry). Declared POINTER so the MPI
