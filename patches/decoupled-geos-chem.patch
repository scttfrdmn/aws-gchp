+PROGRAM KPP_Worker
+  !
+  ! Decoupled-Chemistry KPP worker.
+  !
+  ! Two modes, selected by argv:
+  !
+  !   (Phase 1a) one-shot FILE mode:   kpp_worker <input_dump.bin> <output.bin>
+  !     Reads the flat KPP-input buffers fullchem dumped (env GCHP_DUMP_CHEM),
+  !     replays the per-cell solve, writes solved C_1D to a file. A diff harness
+  !     byte-compares vs fullchem's golden dump. This is the offline
+  !     byte-identity proof and is retained as a regression.
+  !
+  !   (Phase 1b) SERVICE mode:         kpp_worker --service
+  !     Attaches this rank's POSIX shm segments + named semaphores (keyed by env
+  !     GCHP_CHEM_RANK + GCHP_JOBID, see chem_remote_mod), then loops:
+  !         sem_wait(ready) -> (sentinel? exit) -> solve 1:ncell_local in shm
+  !         -> sem_post(done)
+  !     The buffers ARE shared memory, so the solve reads/writes them in place
+  !     (zero-copy) and the co-located GCHP rank sees the results directly. The
+  !     per-cell body is IDENTICAL to file mode -- same integrator, same flags,
+  !     same retry, same envelope -- so bit-identity carries over from Phase 1a.
+  !
+  ! Links ONLY the KPP static lib (gckpp_* + fullchem_*Funcs) -- no GEOS-Chem
+  ! State_* deps. Built in the SAME cmake configure as GCHP so compiler flags,
+  ! -mcpu, ffp-contract and the KPP_INTEGRATOR_AUTOREDUCE def match exactly
+  ! (bit-identity requirement). chem_remote_mod + chem_remote_shm.c are compiled
+  ! directly into this executable (see src/CMakeLists.txt).
+  !
+  ! WORKER OUTPUT CONTRACT (Phase 1b, stricter than 1a): the co-located rank's
+  ! scatter reads back C_1D, RSTATE_1D and ISTATUS_1D (RSTATE feeds
+  ! State_Chm%KPPHvalue -> the restart file; ISTATUS feeds the KPP History
+  ! diagnostics). So the worker writes all THREE back, and accumulates ISTATUS
+  ! on the retry exactly as fullchem_mod.F90:1959. (Phase 1a compared only C_1D,
+  ! so it wrote only C_1D; the full-run checkpoint gate needs all three.)
+  !
+  USE ISO_C_BINDING
+  USE GcKpp_Precision
+  USE GcKpp_Parameters              ! NSPEC, NREACT, NVAR, NFIX, ind_SALAAL, ind_SALCAL
+  USE GcKpp_Global                  ! C, RCONST, ATOL, RTOL, MW (module globals;
+                                    ! RCONST is declared here and THREADPRIVATE)
+  USE GcKpp_Integrator, ONLY : Integrate
+  USE Chem_Remote_Mod
+
+  IMPLICIT NONE
+
+  ! ---- header (must mirror the fullchem dump exactly; FILE mode) ----
+  ! NOTE: DT is NOT declared here -- it is a gckpp_Global module variable
+  ! (use-associated). We read the dumped timestep into a local and pass it
+  ! explicitly to Integrate as TOUT, exactly as fullchem does with GET_TS_CHEM.
+  INTEGER  :: h_NSPEC, h_NREACT, h_NVAR, h_NFIX, NCELL, ar_flag, ss_flag
+  REAL(dp) :: DT_in
+  REAL(dp), ALLOCATABLE :: MW_in(:)   ! (NSPEC) molecular weights for the EquivToAlk conversion
+
+  ! ---- flat buffers (FILE mode owns these; SERVICE mode points at shm) ----
+  REAL(dp), POINTER :: C_1D(:,:)      => NULL()  ! (NSPEC, NCELL)   in/out
+  REAL(dp), POINTER :: RCONST_1D(:,:) => NULL()  ! (NREACT,NCELL)   in
+  INTEGER,  POINTER :: ICNTRL_1D(:,:) => NULL()  ! (20, NCELL)      in
+  REAL(dp), POINTER :: RCNTRL_1D(:,:) => NULL()  ! (20, NCELL)      in
+  INTEGER,  POINTER :: ISTATUS_1D(:,:)=> NULL()  ! (20, NCELL)      out (Phase 1b)
+  REAL(dp), POINTER :: RSTATE_1D(:,:) => NULL()  ! (20, NCELL)      out (Phase 1b)
+  REAL(dp), ALLOCATABLE :: ATOL_in(:), RTOL_in(:)   ! (NVAR)  FILE mode
+
+  ! ---- per-cell working ----
+  INTEGER  :: IERR, i, du, ios, nfail2x
+  CHARACTER(len=1024) :: arg1, arg2
+  INTEGER  :: nArgs
+
+  nArgs = COMMAND_ARGUMENT_COUNT()
+  IF ( nArgs < 1 ) THEN
+     WRITE(6,*) 'usage: kpp_worker <input_dump.bin> <output.bin>   (file mode)'
+     WRITE(6,*) '   or: kpp_worker --service                       (shm mode)'
+     STOP 1
+  ENDIF
+  CALL GET_COMMAND_ARGUMENT(1, arg1)
+
+  IF ( TRIM(arg1) == '--service' ) THEN
+     CALL Run_Service_Mode()
+  ELSE
+     IF ( nArgs < 2 ) THEN
+        WRITE(6,*) 'file mode needs <input_dump.bin> <output.bin>'; STOP 1
+     ENDIF
+     CALL GET_COMMAND_ARGUMENT(2, arg2)
+     CALL Run_File_Mode( TRIM(arg1), TRIM(arg2) )
+  ENDIF
+
+CONTAINS
+
+  !===========================================================================
+  ! Per-cell solve. IDENTICAL numerics for both modes and bit-identical to
+  ! fullchem's in-process DECOUPLED_CHEM loop (fullchem_mod.F90:1849-2034):
+  !   load C/RCONST/ICNTRL/RCNTRL -> Integrate -> two-strike retry (with
+  !   ISTATUS accumulation on retry) -> EquivToAlk envelope -> store
+  !   C_1D/RSTATE_1D/ISTATUS_1D back.
+  ! Reads/writes the module-scope POINTER buffers, which are either the
+  ! ALLOCATEd file buffers or the mmap'd shm buffers -- the body doesn't care.
+  ! `n` is the number of real gathered cells to solve (NCELL_local).
+  !===========================================================================
+  SUBROUTINE Solve_Batch( n, dt_local, ar, ss, nfail2x )
+    INTEGER,  INTENT(IN)    :: n, ar, ss
+    REAL(dp), INTENT(IN)    :: dt_local
+    INTEGER,  INTENT(INOUT) :: nfail2x
+    INTEGER  :: ICNTRL(20), ISTATUS(20)
+    REAL(dp) :: RCNTRL(20), RSTATE(20)
+    REAL(dp) :: C_before(NSPEC)
+    INTEGER  :: j, ie
+    LOGICAL  :: Failed2x
+
+    ! Mirror fullchem's sticky Failed2x: once any cell fails twice, the
+    ! in-process loop abandons the REST of the batch (fullchem_mod.F90:1853
+    ! "IF (Failed2x) CYCLE" at the top of every subsequent iteration), leaving
+    ! those cells' C_1D/RSTATE_1D/ISTATUS_1D at their gathered-input values.
+    Failed2x = .FALSE.
+
+    DO j = 1, n
+       IF ( Failed2x ) CYCLE            ! fullchem_mod.F90:1853
+
+       ISTATUS = 0
+       RSTATE  = 0.0_dp
+       ie      = 0
+
+       RCONST(:)  = RCONST_1D(:,j)     ! module array Integrate reads
+       C(:)       = C_1D(:,j)          ! full NSPEC incl FIX = C(NVAR+1:NSPEC)
+       ICNTRL(:)  = ICNTRL_1D(:,j)
+       RCNTRL(:)  = RCNTRL_1D(:,j)
+       C_before   = C
+
+       CALL Integrate( 0.0_dp, dt_local, ICNTRL, RCNTRL, ISTATUS, RSTATE, ie )
+
+       ! store diagnostics from the first call (fullchem_mod.F90:1874-1875).
+       ! These are written UNCONDITIONALLY (even on the failure path below).
+       RSTATE_1D(:,j)  = RSTATE(:)
+       ISTATUS_1D(:,j) = ISTATUS(:)
+
+       ! ---- two-strike retry, identical to fullchem_mod.F90:1928-1965 ----
+       IF ( ie < 0 ) THEN
+          RCNTRL(3) = 0.0_dp
+          C         = C_before
+          IF ( ar == 1 ) RCNTRL(12) = -1.0_dp   ! Use_AutoReduce
+          RCONST(:) = RCONST_1D(:,j)
+          CALL Integrate( 0.0_dp, dt_local, ICNTRL, RCNTRL, ISTATUS, RSTATE, ie )
+          ! accumulate ISTATUS (counts), overwrite RSTATE (fullchem:1959-1960)
+          ISTATUS_1D(:,j) = ISTATUS_1D(:,j) + ISTATUS(:)
+          RSTATE_1D(:,j)  = RSTATE(:)
+          IF ( ie < 0 ) THEN
+             ! DOUBLE failure: fullchem's GCHP path (non-GEOS) sets Failed2x
+             ! and CYCLEs (fullchem_mod.F90:1993,2017) -- it does NOT apply the
+             ! envelope and does NOT store C_1D, so the cell keeps its gathered
+             ! input. Replicate exactly: mark Failed2x + skip envelope/store.
+             Failed2x = .TRUE.
+             nfail2x  = nfail2x + 1
+             CYCLE
+          ENDIF
+       ENDIF
+
+       ! ---- post-Integrate envelope (successful cells only):
+       !      fullchem_ConvertEquivToAlk on SALAAL/SALCAL when
+       !      .not.Do_SulfateMod_SeaSalt (ss==1). fullchem_SulfurChemFuncs.F90:94. ----
+       IF ( ss == 1 ) THEN
+          C(ind_SALAAL) = C(ind_SALAAL) / ( MW(ind_SALAAL) * 7.0e-5_dp )
+          C(ind_SALCAL) = C(ind_SALCAL) / ( MW(ind_SALCAL) * 7.0e-5_dp )
+       ENDIF
+
+       C_1D(:,j) = C(:)                ! store only on success (matches CYCLE skip)
+    ENDDO
+  END SUBROUTINE Solve_Batch
+
+  !===========================================================================
+  ! Phase 1a FILE mode: read dump -> Solve_Batch -> write solved C_1D.
+  !===========================================================================
+  SUBROUTINE Run_File_Mode( infile, outfile )
+    CHARACTER(len=*), INTENT(IN) :: infile, outfile
+
+    OPEN( newunit=du, file=infile, form='unformatted', access='stream',       &
+          status='old', action='read', iostat=ios )
+    IF ( ios /= 0 ) THEN
+       WRITE(6,*) 'kpp_worker: cannot open input ', infile; STOP 2
+    ENDIF
+    READ(du) h_NSPEC, h_NREACT, h_NVAR, h_NFIX, NCELL, ar_flag, ss_flag
+    READ(du) DT_in
+
+    IF ( h_NSPEC /= NSPEC .OR. h_NREACT /= NREACT .OR.                         &
+         h_NVAR  /= NVAR  .OR. h_NFIX   /= NFIX ) THEN
+       WRITE(6,*) 'kpp_worker: MECHANISM MISMATCH. dump=(', h_NSPEC, h_NREACT, &
+            h_NVAR, h_NFIX, ') worker=(', NSPEC, NREACT, NVAR, NFIX, ')'
+       STOP 3
+    ENDIF
+
+    ALLOCATE( ATOL_in(NVAR), RTOL_in(NVAR), MW_in(NSPEC) )
+    ALLOCATE( C_1D(NSPEC,NCELL), RCONST_1D(NREACT,NCELL) )
+    ALLOCATE( ICNTRL_1D(20,NCELL), RCNTRL_1D(20,NCELL) )
+    ALLOCATE( ISTATUS_1D(20,NCELL), RSTATE_1D(20,NCELL) )
+    READ(du) ATOL_in(1:NVAR)
+    READ(du) RTOL_in(1:NVAR)
+    READ(du) MW_in(1:NSPEC)
+    READ(du) C_1D
+    READ(du) RCONST_1D
+    READ(du) ICNTRL_1D
+    READ(du) RCNTRL_1D
+    CLOSE(du)
+
+    ! ATOL/RTOL are module globals; set once from shipped values.
+    ATOL(1:NVAR) = ATOL_in(1:NVAR)
+    RTOL(1:NVAR) = RTOL_in(1:NVAR)
+    MW(1:NSPEC)  = MW_in(1:NSPEC)   ! for the EquivToAlk envelope
+
+    ! contract keystone guard: ICNTRL(15) MUST be -1
+    DO i = 1, NCELL
+       IF ( ICNTRL_1D(15,i) /= -1 ) THEN
+          WRITE(6,*) 'kpp_worker: ICNTRL(15)=', ICNTRL_1D(15,i), ' at cell', i, &
+               ' (need -1). ABORT.'; STOP 4
+       ENDIF
+    ENDDO
+
+    nfail2x = 0
+    CALL Solve_Batch( NCELL, DT_in, ar_flag, ss_flag, nfail2x )
+    IF ( nfail2x > 0 ) WRITE(6,*) 'kpp_worker: ', nfail2x, ' cells failed twice'
+
+    OPEN( newunit=du, file=outfile, form='unformatted', access='stream',      &
+          status='replace', action='write', iostat=ios )
+    IF ( ios /= 0 ) THEN
+       WRITE(6,*) 'kpp_worker: cannot open output ', outfile; STOP 5
+    ENDIF
+    WRITE(du) NSPEC, NCELL
+    WRITE(du) C_1D
+    CLOSE(du)
+    WRITE(6,*) 'kpp_worker: solved ', NCELL, ' cells -> ', outfile
+  END SUBROUTINE Run_File_Mode
+
+  !===========================================================================
+  ! Phase 1b SERVICE mode: attach shm, then loop until the exit sentinel.
+  !===========================================================================
+  SUBROUTINE Run_Service_Mode()
+    TYPE(C_PTR) :: cp_C, cp_RCONST, cp_ICNTRL, cp_RCNTRL, cp_ISTAT, cp_RSTATE
+    LOGICAL     :: ok
+    INTEGER     :: cmd, n, ar, ss, ncell_tot, nsteps
+    REAL(dp)    :: dt_local
+    REAL(C_DOUBLE) :: attach_wait_s
+
+    attach_wait_s = 60.0_C_DOUBLE   ! bounded-retry attach budget (rank creates early)
+
+    CALL Chem_Remote_Worker_Attach( NSPEC, NREACT, NVAR, NFIX, attach_wait_s, &
+         cp_C, cp_RCONST, cp_ICNTRL, cp_RCNTRL, cp_ISTAT, cp_RSTATE, ok )
+    IF ( .NOT. ok ) THEN
+       WRITE(6,*) 'kpp_worker[service]: attach FAILED -> exit'
+       ! record fatal status so the rank falls back rather than hanging
+       IF ( ASSOCIATED(gcr_ctl) ) gcr_ctl%worker_status = -1
+       STOP 6
+    ENDIF
+
+    ! Map the six shm segments onto this process's KPP-shaped pointers.
+    ncell_tot = INT(gcr_ctl%ncell_total)
+    CALL C_F_POINTER( cp_C,      C_1D,       [NSPEC,  ncell_tot] )
+    CALL C_F_POINTER( cp_RCONST, RCONST_1D,  [NREACT, ncell_tot] )
+    CALL C_F_POINTER( cp_ICNTRL, ICNTRL_1D,  [20,     ncell_tot] )
+    CALL C_F_POINTER( cp_RCNTRL, RCNTRL_1D,  [20,     ncell_tot] )
+    CALL C_F_POINTER( cp_ISTAT,  ISTATUS_1D, [20,     ncell_tot] )
+    CALL C_F_POINTER( cp_RSTATE, RSTATE_1D,  [20,     ncell_tot] )
+
+    ! ATOL/RTOL/MW live in the const segment [ATOL(NVAR) RTOL(NVAR) MW(NSPEC)].
+    ATOL(1:NVAR) = gcr_const(1:NVAR)
+    RTOL(1:NVAR) = gcr_const(NVAR+1:2*NVAR)
+    MW(1:NSPEC)  = gcr_const(2*NVAR+1:2*NVAR+NSPEC)
+
+    nfail2x = 0
+    nsteps  = 0
+    DO
+       cmd = Chem_Remote_Worker_Wait()          ! blocks on sem ready
+       IF ( cmd == GCR_CMD_EXIT ) EXIT           ! sentinel from rank's Final
+
+       n  = INT(gcr_ctl%ncell_local)
+       dt_local = REAL(gcr_ctl%dt, dp)
+       ar = INT(gcr_ctl%ar_flag)
+       ss = INT(gcr_ctl%ss_flag)
+
+       ! keystone guard on the first cell only (cheap; all shipped cells have
+       ! ICNTRL(15)=-1 because the rank ships 1:ncell_local, never zero-pad).
+       IF ( n >= 1 ) THEN
+          IF ( ICNTRL_1D(15,1) /= -1 ) THEN
+             WRITE(6,*) 'kpp_worker[service]: ICNTRL(15)/=-1; refusing batch'
+             gcr_ctl%worker_status = -2
+             CALL Chem_Remote_Worker_Done()      ! release rank -> it falls back
+             CYCLE
+          ENDIF
+       ENDIF
+
+       CALL Solve_Batch( n, dt_local, ar, ss, nfail2x )
+       gcr_ctl%worker_status = 0
+       nsteps = nsteps + 1
+       CALL Chem_Remote_Worker_Done()            ! post sem done
+    ENDDO
+
+    WRITE(6,'(a,i0,a,i0,a)') 'kpp_worker[service]: exit after ', nsteps,      &
+         ' supersteps (', nfail2x, ' cells failed twice)'
+    CALL Chem_Remote_Worker_Detach()
+  END SUBROUTINE Run_Service_Mode
+
+END PROGRAM KPP_Worker
