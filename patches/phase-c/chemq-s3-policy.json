{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ChemQueueObjectRW",
      "Effect": "Allow",
      "Action": ["s3:PutObject","s3:GetObject","s3:DeleteObject"],
      "Resource": "arn:aws:s3:::gchp-shared-storage-us-east-1/chemq/*"
    },
    {
      "Sid": "ChemQueueList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::gchp-shared-storage-us-east-1",
      "Condition": {"StringLike": {"s3:prefix": "chemq/*"}}
    }
  ]
}
