+#-----------------------------------------------------------------------------
+# DECOUPLED_CHEM_WORKER (Phase 1a): a standalone kpp_worker executable that
+# reads the flat KPP-input buffers dumped by fullchem's DECOUPLED_CHEM path
+# and replays the per-cell solve, for the offline byte-identity proof. It
+# links the SAME KPP mechanism lib (transitively inheriting
+# GEOSChemBuildProperties + KPP_INTEGRATOR_AUTOREDUCE) and uses the SAME
+# -fdefault-real-8/-double-8 as KPPStandalone, so the compiled integrator is
+# bit-for-bit the one fullchem calls in-process.
+#-----------------------------------------------------------------------------
+if (${DECOUPLED_CHEM_WORKER})
+  if("${MECH}" STREQUAL fullchem OR "${MECH}" STREQUAL custom)
+    add_executable(kpp_worker
+      GCHP_GridComp/GEOSChem_GridComp/geos-chem/GeosCore/kpp_worker.F90
+      )
+    # KPP = the mechanism/integrator (bit-identity); ChemRemote = the Phase 1b
+    # shm transport module + POSIX shim (Phase 1b service mode). ChemRemote
+    # brings rt+pthread transitively. Both are built in this same configure so
+    # the compiled integrator is bit-for-bit the one fullchem calls in-process.
+    target_link_libraries(kpp_worker PUBLIC KPP ChemRemote)
+    target_compile_options(kpp_worker
+      PRIVATE
+      $<$<STREQUAL:"${CMAKE_Fortran_COMPILER_ID}","Intel">:-r8>
+      $<$<STREQUAL:"${CMAKE_Fortran_COMPILER_ID}","GNU">:-fdefault-real-8 -fdefault-double-8>
+      )
+    set_target_properties(kpp_worker
+      PROPERTIES RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin
+      )
+  endif()
+endif()
+
 #-----------------------------------------------------------------------------
 # Allow GCHP to be installed either to the path specified by -DRUNDIR or
 # -DINSTALLCOPY.  In most instances, the build directory is a subdirectory
diff --git a/src/GCHP_GridComp/GEOSChem_GridComp/CMakeLists.txt b/src/GCHP_GridComp/GEOSChem_GridComp/CMakeLists.txt
