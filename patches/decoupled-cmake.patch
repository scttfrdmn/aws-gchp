-# Load balancing on by default, but turn off if using KPP standalone
+# Decoupled-chemistry in-process backend (Phase 0 of decoupled-execution work).
+# Off by default. When ON, chemistry uses the same gather/solve/scatter seam as
+# MPI_LOAD_BALANCE but solves in-process (plain loop, no MPI windows) so the
+# refactor can be proven bitwise-identical to the stock per-cell solve. It is
+# mutually exclusive with MPI_LOAD_BALANCE (both drive the same code regions).
+set(DECOUPLED_CHEM OFF CACHE BOOL
+  "In-process gather/solve/scatter chemistry backend (decoupled-chem Phase 0)"
+)
+
+# Decoupled-chemistry Phase 1a offline worker. When ON, builds a standalone
+# kpp_worker executable (src/CMakeLists.txt) that replays the flat KPP buffers
+# fullchem's DECOUPLED_CHEM path dumps, for the byte-identity proof. Implies
+# DECOUPLED_CHEM (the worker consumes that path's dumps).
+set(DECOUPLED_CHEM_WORKER OFF CACHE BOOL
+  "Build the offline kpp_worker executable (decoupled-chem Phase 1a)"
+)
+if(${DECOUPLED_CHEM_WORKER})
+  set(DECOUPLED_CHEM ON)
+endif()
+
+# Load balancing on by default, but turn off if using KPP standalone or the
+# decoupled-chem in-process backend (either one owns the gather/solve/scatter path).
 set(MPI_LOAD_BALANCE ON CACHE BOOL
   "Switch to apply MPI load balance in chemistry if using GCHP"
 )
 if(${KPPSA})
   set(MPI_LOAD_BALANCE OFF)
 endif()
+if(${DECOUPLED_CHEM})
+  set(MPI_LOAD_BALANCE OFF)
+endif()
 
 # Add directories to build
 add_subdirectory(Cloud-J EXCLUDE_FROM_ALL)
